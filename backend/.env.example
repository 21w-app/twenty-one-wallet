# Local — matches backend/docker-compose.yml
DATABASE_URL="postgresql://21w:21w@localhost:5433/21w?schema=public"

PORT=3000
NODE_ENV=development

# App version policy (TASK-065) — permissive defaults until owner raises
MIN_SUPPORTED_APP_VERSION=1.0.0
MIN_IOS_BUILD=
MIN_ANDROID_BUILD=
IOS_STORE_URL=
ANDROID_STORE_URL=
UPDATE_MESSAGE=

# Ark indexer + push workers (TASK-057+)
ARK_INDEXER_URL=https://arkade.computer
EXPO_ACCESS_TOKEN=
VTXO_EXPIRY_POLL_INTERVAL_MS=3600000
VTXO_REMINDER_COOLDOWN_MS=86400000
CHALLENGE_TTL_SECONDS=300
WORKERS_ENABLED=true
VTXO_EXPIRY_WORKER_ENABLED=false

# Set to true when TASK-058 is deployed (staging/production)
# VTXO_EXPIRY_WORKER_ENABLED=true
