# Copy to apps/mobile/.env for local builds (gitignored).
# EAS cloud builds: set the same keys in the Expo project Environment variables
# and/or upload google-services.json as an EAS file secret named GOOGLE_SERVICES_JSON.

# Required for OTA URL + extra.eas.projectId (from expo.dev → project settings)
EAS_PROJECT_ID=

# Optional override; defaults to ./google-services.json when the file exists locally.
# On EAS, file secrets expose a filesystem path via this variable name.
GOOGLE_SERVICES_JSON=

# Backend API base URL.
# Local default: your machine. For store/OTA builds, set your own host in
# Expo project Environment variables (do not point clones at someone else's API).
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
